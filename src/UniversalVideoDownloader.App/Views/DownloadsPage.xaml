<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UniversalVideoDownloader.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniversalVideoDownloader.App"
    xmlns:vm="using:UniversalVideoDownloader.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="24" RowSpacing="12" Background="{ThemeResource JupiterWindowBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox x:Name="LinksInput" Header="Video or audio links" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
       PlaceholderText="Paste links here, or drop them onto this page."
       Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Grid.Row="1" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Add to queue" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddFromInputCommand}" />
          <Button Content="Add from clipboard" Command="{x:Bind ViewModel.AddFromClipboardCommand}" />
          <Button Content="Import text file…" Command="{x:Bind ViewModel.ImportFileCommand}" />
          <ToggleSwitch Header="New links" OffContent="Video" OnContent="Audio only" IsOn="{x:Bind ViewModel.AddAsAudio, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="{x:Bind ViewModel.InputSummary, Mode=OneWay}" />
      </StackPanel>
      <Grid Grid.Row="2" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterSectionHeadingTextStyle}" Text="Queue" />
        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="{ThemeResource JupiterWindowBrush}">
          <AppBarButton Label="{x:Bind ViewModel.QueueToggleText, Mode=OneWay}" Icon="Play" Command="{x:Bind ViewModel.ToggleQueueCommand}" />
          <AppBarButton Label="Retry failed" Icon="Refresh" Command="{x:Bind ViewModel.RetryFailedCommand}" />
          <AppBarButton Label="Clear finished" Icon="Clear" Command="{x:Bind ViewModel.ClearFinishedCommand}" />
          <AppBarButton Label="Open folder" Icon="Folder" Command="{x:Bind ViewModel.OpenOutputFolderCommand}" />
          <CommandBar.SecondaryCommands><AppBarButton Label="Cancel all" Command="{x:Bind ViewModel.CancelAllCommand}" /></CommandBar.SecondaryCommands>
        </CommandBar>
      </Grid>
        <!-- Queue -->
        <Grid Grid.Row="3">
            <TextBlock TextWrapping="Wrap"
                Margin="0,24"
                HorizontalAlignment="Center"
                Style="{StaticResource JupiterCaptionTextStyle}"
                TextAlignment="Center"
                Text="Nothing queued. Paste links above, add them from the clipboard, import a text file, or drag links onto this window."
                Visibility="{x:Bind local:XamlConvert.Visible(ViewModel.IsEmpty), Mode=OneWay}" />

            <ListView x:Name="QueueList" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.Items}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                        <Border Padding="12" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <FontIcon
                                    Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource JupiterNavigationIconSize}"
                                    Glyph="{x:Bind ModeGlyph}"
                                    ToolTipService.ToolTip="{x:Bind ModeText}" />

                                <TextBlock TextWrapping="NoWrap"
                                    Grid.Column="1"
                                    Style="{StaticResource JupiterBodyStrongTextStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Url}" />

                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource JupiterCaptionTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{x:Bind Host}" />
                                    <Run Text="  " />
                                    <Run Text="{x:Bind DetailText, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button AutomationProperties.Name="Open the file"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind OpenFileCommand}"
                                        ToolTipService.ToolTip="Open the file"
                                        Visibility="{x:Bind local:XamlConvert.Visible(HasFile), Mode=OneWay}">
                                        <FontIcon Glyph="&#xE768;" Style="{StaticResource JupiterCommandIconStyle}" />
                                    </Button>
                                    <Button AutomationProperties.Name="Download again"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind RetryCommand}"
                                        ToolTipService.ToolTip="Download again"
                                        Visibility="{x:Bind local:XamlConvert.Visible(CanRetry), Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72C;" Style="{StaticResource JupiterCommandIconStyle}" />
                                    </Button>
                                    <Button AutomationProperties.Name="Cancel"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind CancelCommand}"
                                        ToolTipService.ToolTip="Cancel"
                                        Visibility="{x:Bind local:XamlConvert.Visible(CanCancel), Mode=OneWay}">
                                        <FontIcon Glyph="&#xE711;" Style="{StaticResource JupiterCommandIconStyle}" />
                                    </Button>
                                    <Button AutomationProperties.Name="More" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More">
                                        <FontIcon Glyph="&#xE712;" Style="{StaticResource JupiterCommandIconStyle}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Show in folder" Command="{x:Bind RevealFileCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE838;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Show or hide log" Command="{x:Bind ToggleLogCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy link" Command="{x:Bind CopyUrlCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Remove from queue" Command="{x:Bind RemoveCommand}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                <ProgressBar
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Maximum="100"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                    Visibility="{x:Bind local:XamlConvert.Visible(ShowProgress), Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Foreground="{ThemeResource JupiterErrorBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:XamlConvert.Visible(HasError), Mode=OneWay}" />

                                <Border
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    MaxHeight="200"
                                    Padding="8"
                                    Background="{ThemeResource JupiterInputBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Visibility="{x:Bind local:XamlConvert.Visible(IsLogVisible), Mode=OneWay}">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{x:Bind LogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterMonoCaptionTextStyle}" Text="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
