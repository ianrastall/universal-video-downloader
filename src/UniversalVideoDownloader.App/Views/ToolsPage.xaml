<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UniversalVideoDownloader.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniversalVideoDownloader.App"
    xmlns:vm="using:UniversalVideoDownloader.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterPageHeadingTextStyle}" Text="Tools" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="yt-dlp does the downloading. Deno lets it handle YouTube's player checks, and ffmpeg merges and converts the result. All three come from their official releases and are checked against the published SHA-256 before installing." />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" IsTextSelectionEnabled="True">
                        <Run Text="Folder: " />
                        <Run Text="{x:Bind ViewModel.ToolsDirectory, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Command="{x:Bind ViewModel.CheckForUpdatesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" Style="{StaticResource JupiterCommandIconStyle}" />
                            <TextBlock TextWrapping="Wrap" Text="Check for updates" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UpdateAllCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" Style="{StaticResource JupiterCommandIconStyle}" />
                            <TextBlock TextWrapping="Wrap" Text="Install or update all" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Open the tools folder" Command="{x:Bind ViewModel.OpenToolsFolderCommand}" ToolTipService.ToolTip="Open the tools folder">
                        <FontIcon Glyph="&#xE838;" Style="{StaticResource JupiterCommandIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4" Visibility="{x:Bind local:XamlConvert.Visible(ViewModel.IsBusy), Mode=OneWay}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolItemViewModel">
                        <Border>
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterBodyStrongTextStyle}" Text="{x:Bind Name}" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="{x:Bind Description}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" IsTextSelectionEnabled="True">
                                        <Run Text="Installed: " Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                                        <Run Text="{x:Bind InstalledText, Mode=OneWay}" />
                                        <Run Text="     Latest: " Foreground="{ThemeResource JupiterSecondaryTextBrush}" />
                                        <Run Text="{x:Bind LatestText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    MinWidth="96"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ActionText, Mode=OneWay}"
                                    Command="{x:Bind InstallCommand}" />

                                <ProgressBar
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Maximum="100"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                    Visibility="{x:Bind local:XamlConvert.Visible(IsWorking), Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource JupiterBodyStrongTextStyle}" Text="Activity" />
            <Border MinHeight="80">
                <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterMonoCaptionTextStyle}" Text="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
