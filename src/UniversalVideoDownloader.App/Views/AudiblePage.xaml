<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UniversalVideoDownloader.App.Views.AudiblePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:UniversalVideoDownloader.Core.Downloads"
    xmlns:local="using:UniversalVideoDownloader.App"
    NavigationCacheMode="Required">

    <Grid Padding="24" RowSpacing="12" Background="{ThemeResource JupiterWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Audible Library" Style="{StaticResource JupiterPageHeadingTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                Style="{StaticResource JupiterCaptionTextStyle}" />
        </StackPanel>

        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right"
            Background="{ThemeResource JupiterWindowBrush}">
            <AppBarButton Label="Open Libation" Command="{x:Bind ViewModel.OpenLibationCommand}" />
            <AppBarButton Label="Load saved library" Icon="OpenFile" Command="{x:Bind ViewModel.LoadSavedCommand}" />
            <AppBarButton Label="Refresh from Audible" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarButton Label="Queue selected title" Icon="Add" Command="{x:Bind ViewModel.QueueSelectedCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Choose Libation folderâ€¦" Command="{x:Bind ViewModel.ChooseLibationCommand}" />
                <AppBarButton Label="Open Books folder" Command="{x:Bind ViewModel.OpenBooksFolderCommand}" />
                <AppBarButton Label="Cancel library operation" Command="{x:Bind ViewModel.CancelCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <StackPanel Grid.Row="2" Spacing="4">
            <HyperlinkButton Content="Get Libation" NavigateUri="https://github.com/rmcrackan/Libation/releases/latest" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:XamlConvert.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="3" SelectionMode="Single" AutomationProperties.Name="Audible titles"
            ItemsSource="{x:Bind ViewModel.Titles}" SelectedItem="{x:Bind ViewModel.SelectedTitle, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:AudibleTitle">
                    <StackPanel Spacing="4" Padding="0,8">
                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource JupiterBodyStrongTextStyle}" />
                        <TextBlock Text="{x:Bind Authors}" TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" />
                        <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
