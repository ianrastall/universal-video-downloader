<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UniversalVideoDownloader.App.Views.ClipboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniversalVideoDownloader.App"
    xmlns:vm="using:UniversalVideoDownloader.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer><StackPanel Padding="24" Spacing="16">
    <TextBlock TextWrapping="Wrap" Text="Clipboard" Style="{StaticResource JupiterPageHeadingTextStyle}" />
    <TextBlock Text="Copied video links collect here while this app is open. Select the links to add to your queue." Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
        <!-- Clipboard inbox -->
        <Border Grid.Row="0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE77F;" Style="{StaticResource JupiterCommandIconStyle}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterBodyStrongTextStyle}" Text="Clipboard" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource JupiterCaptionTextStyle}" Text="{x:Bind Inbox.Summary, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleSwitch
                            MinWidth="0"
                            OffContent="Not watching"
                            OnContent="Watching"
                            ToolTipService.ToolTip="Collect video links whenever you copy them in any app"
                            IsOn="{x:Bind Inbox.IsWatching, Mode=TwoWay}" />
                        <Button AutomationProperties.Name="Collect video links from Windows clipboard history (Win+V)" Command="{x:Bind Inbox.ScanHistoryCommand}" ToolTipService.ToolTip="Collect video links from Windows clipboard history (Win+V)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE81C;" Style="{StaticResource JupiterCommandIconStyle}" />
                                <TextBlock TextWrapping="Wrap" Text="Scan clipboard history" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" RowSpacing="8" Visibility="{x:Bind local:XamlConvert.Visible(Inbox.HasLinks), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView
                        MaxHeight="480"
                        SelectionMode="None"
                        ItemsSource="{x:Bind Inbox.Links}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectedLinkViewModel">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox AutomationProperties.Name="{x:Bind Url}" MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <TextBlock TextWrapping="Wrap"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Url}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Url}" />
                                    <TextBlock TextWrapping="Wrap"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource JupiterCaptionTextStyle}"
                                        Text="{x:Bind Host}" />
                                    <Button AutomationProperties.Name="Remove from this list"
                                        Grid.Column="3"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind RemoveCommand}"
                                        ToolTipService.ToolTip="Remove from this list">
                                        <FontIcon Glyph="&#xE711;" Style="{StaticResource JupiterSmallIconStyle}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Inbox.AddSelectedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" Style="{StaticResource JupiterCommandIconStyle}" />
                                <TextBlock TextWrapping="Wrap" Text="Add ticked to queue" />
                            </StackPanel>
                        </Button>
                        <Button Content="Tick all / none" Command="{x:Bind Inbox.SelectAllCommand}" />
                        <Button Content="Clear list" Command="{x:Bind Inbox.ClearCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </StackPanel></ScrollViewer>
</Page>